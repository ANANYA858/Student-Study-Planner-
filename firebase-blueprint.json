{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with academic focus, circadian preferences, and streaks",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "targetExam": { "type": "string" },
        "streak": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "TaskSlot": {
      "title": "TaskSlot",
      "description": "Scheduled time slot or study task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "time": { "type": "string" },
        "duration": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "category": { "type": "string" },
        "completed": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "userId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Gemini AI chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "role", "text", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "TaskSlot",
      "description": "Stores user schedule slots"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Stores chat messages with Gemini tutor"
    }
  }
}
